{
  "name": "aegis-sarl/sdk",
  "description": "Aegis in-app firewall for PHP. Inspects requests, reports what it saw, and blocks only when told to.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "security",
    "waf",
    "runtime-protection",
    "middleware"
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "Aegis\\": "src/"
    }
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
